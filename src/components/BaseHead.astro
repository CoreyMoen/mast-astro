---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /**
   * Appended to page titles ("Page · Site") and used for og:site_name.
   * A page whose title is the site name gets it once.
   */
  siteName?: string;
}

const { title, description, siteName } = Astro.props;

const fullTitle =
  siteName && title !== siteName ? `${title} · ${siteName}` : title;
---

{
  /*
  The framework's part of <head>: Mast's stylesheet, the essential meta,
  and the pre-paint theme script. Favicons, fonts, and theme-color belong
  to the site; pass them through BaseLayout's "head" slot.
*/
}
<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1" name="viewport" />
<title>{fullTitle}</title>
<meta content={title} property="og:title" />
{siteName && <meta content={siteName} property="og:site_name" />}
<meta content="website" property="og:type" />
<meta content="summary" name="twitter:card" />
<meta content={title} name="twitter:title" />
{description && <meta content={description} name="description" />}
{description && <meta content={description} property="og:description" />}
{description && <meta content={description} name="twitter:description" />}

<script is:inline>
  // Mark JS availability (gates scroll animations) and apply the saved
  // theme before first paint to avoid a flash of the wrong mode.
  (function () {
    var docEl = document.documentElement;
    docEl.classList.add("js");
    function applyMode(isLight) {
      docEl.classList.toggle("u-mode-light", isLight);
      docEl.classList.toggle("u-mode-dark", !isLight);
    }
    try {
      var savedTheme = localStorage.getItem("savedTheme");
      var osQuery = window.matchMedia("(prefers-color-scheme: dark)");
      applyMode(
        savedTheme !== null ? savedTheme === "light" : !osQuery.matches,
      );
      if (savedTheme === null) {
        // Track live OS theme changes until the user picks a mode —
        // re-checked at event time so a same-session choice sticks.
        osQuery.addEventListener("change", function (e) {
          try {
            if (localStorage.getItem("savedTheme") !== null) return;
          } catch (err) {
            /* fall through and follow the OS */
          }
          applyMode(!e.matches);
        });
      }
    } catch (e) {
      /* Storage unavailable; fall back to the OS preference via CSS. */
    }
  })();
</script>
