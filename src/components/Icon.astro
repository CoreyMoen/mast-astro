---
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";
import type { HTMLAttributes } from "astro/types";
import { getChoices } from "@/dials.ts";

interface Props extends HTMLAttributes<"span"> {
  /** Phosphor icon name, e.g. "arrow-right". */
  name: string;
  /** Icon size. `base` inherits the current font size. */
  size?: "base" | "md" | "lg" | "xl";
  color?: "inherit" | "accent" | "yellow" | "blue";
}

const {
  name,
  size = "base",
  color = "inherit",
  class: className,
  ...rest
} = Astro.props;

// The icon is inlined at build time — no icon font or extra request.
// Its weight is the `iconWeight` dial (src/dials.ts).
const { iconWeight } = getChoices();
const file = iconWeight === "regular" ? name : `${name}-${iconWeight}`;
const require = createRequire(import.meta.url);
const svg = readFileSync(
  require.resolve(`@phosphor-icons/core/assets/${iconWeight}/${file}.svg`),
  "utf8",
);
---

<span
  class:list={["icon-color", color !== "inherit" && `cc-${color}`, className]}
  {...rest}
>
  <span
    class:list={["icon", size !== "base" && `cc-${size}`]}
    aria-hidden="true"
    set:html={svg}
  />
</span>
