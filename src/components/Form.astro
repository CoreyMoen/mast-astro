---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"form"> {
  /** Note shown at the bottom-right of the form. */
  requiredNote?: string;
  /**
   * The success/error blocks render hidden (`.form-success`/`.form-error`
   * are display:none). Whatever handles the submission — your endpoint's
   * script, an Astro Action, etc. — shows the right one by setting its
   * `display`; the framework ships no submission handler of its own.
   */
  successMessage?: string;
  errorMessage?: string;
}

const {
  requiredNote = "*Required",
  successMessage = "Thank you for your submission!",
  errorMessage = "Oops! Something went wrong while submitting the form.",
  class: className,
  ...rest
} = Astro.props;
---

<div class="u-mb-0">
  <form class:list={["form", className]} {...rest}>
    <slot />
    {requiredNote && <div class="form_required-note">{requiredNote}</div>}
  </form>
  <div class="form-success">
    <div class="form-success_flex">
      <h3>{successMessage}</h3>
    </div>
  </div>
  <div class="form-error">
    <div>{errorMessage}</div>
  </div>
</div>
