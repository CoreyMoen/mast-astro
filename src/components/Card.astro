---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** Highlight the card background on hover (for linked cards). */
  hover?: boolean;
  /**
   * Make the whole card clickable: renders a cover link over the card.
   * Provide `linkLabel` for screen readers.
   */
  href?: string;
  linkLabel?: string;
}

const {
  hover = false,
  href,
  linkLabel,
  class: className,
  ...rest
} = Astro.props;
---

<div class:list={["card", hover && "cc-hover", className]} {...rest}>
  <slot />
  {
    href && (
      <a href={href} class="u-link-cover">
        <span class="u-sr-only">{linkLabel ?? "Read more"}</span>
      </a>
    )
  }
</div>
