---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** Render the top-rule wrapper treatment. */
  rule?: boolean;
}

const { rule = true, class: className, ...rest } = Astro.props;
---

{
  rule ? (
    <div class:list={["eyebrow-component", className]} {...rest}>
      <div class="eyebrow">
        <slot />
      </div>
    </div>
  ) : (
    <div class:list={["eyebrow", className]} {...rest}>
      <slot />
    </div>
  )
}
