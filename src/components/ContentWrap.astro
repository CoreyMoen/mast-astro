---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** Content alignment inside the wrapper. */
  align?: "stretch" | "left" | "center";
}

const { align = "stretch", class: className, ...rest } = Astro.props;
---

<div class="content-wrap-component">
  <div
    class:list={[
      "slot",
      "cc-content-wrap",
      align === "left" && "cc-align-left",
      align === "center" && "cc-align-center",
      className,
    ]}
    {...rest}
  >
    <slot />
  </div>
</div>
