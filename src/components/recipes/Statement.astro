---
/**
 * One sentence that carries the brand: a mission, a quote.
 *  standard:  a centered (or left) heading at reading width
 *  offset:    pushed in from the left by an offset
 *  editorial: display-size, full width, attribution set opposite
 */
import Section from "@/components/Section.astro";
import Row from "@/components/Row.astro";
import Col from "@/components/Col.astro";
import Spacer from "@/components/Spacer.astro";
import { getChoices, type Choices } from "@/dials.ts";
import { isCentered, measure, breath } from "./rhythm.ts";

interface Props {
  /** Override the dials for this one section. */
  choices?: Partial<Choices>;
  eyebrow?: string;
  text: string;
  attribution?: string;
  theme?: "base" | "alt";
}

const layout = { ...getChoices(), ...Astro.props.choices };
const { eyebrow, text, attribution, theme = "alt" } = Astro.props;
const centered = isCentered(layout, "intro");
const space = breath(layout);
---

<Section {theme} data-recipe="statement" data-variant={layout.composition}>
  {
    layout.composition === "standard" && (
      <Row justify={centered ? "center" : "start"}>
        <Col
          size={Math.min(measure(layout) + 2, 12) as 8 | 10 | 12}
          class={centered ? "u-text-center" : undefined}
        >
          {eyebrow && <div class="eyebrow">{eyebrow}</div>}
          <h2>{text}</h2>
          {attribution && <p class="u-mb-0">{attribution}</p>}
        </Col>
      </Row>
    )
  }
  {
    layout.composition === "offset" && (
      <Row justify={centered ? "center" : "start"}>
        <Col
          size={8}
          class={centered ? "u-text-center" : "col-lg-offset-3 col-md-offset-0"}
        >
          {eyebrow && (
            <div
              class:list={["eyebrow", centered ? "u-text-center" : "cc-rule"]}
            >
              {eyebrow}
            </div>
          )}
          <h2>{text}</h2>
          {attribution && <p class="u-mb-0">{attribution}</p>}
        </Col>
      </Row>
    )
  }
  {
    layout.composition === "editorial" && (
      <>
        {eyebrow && (
          <div class:list={["eyebrow", centered ? "u-text-center" : "cc-rule"]}>
            {eyebrow}
          </div>
        )}
        {space && <Spacer size={space} />}
        <h2 class:list={["h1", centered && "u-text-center"]}>{text}</h2>
        {attribution && (
          <Row justify={centered ? "center" : "end"}>
            <Col size="shrink">
              <p class="paragraph-lg u-mb-0">{attribution}</p>
            </Col>
          </Row>
        )}
      </>
    )
  }
</Section>
