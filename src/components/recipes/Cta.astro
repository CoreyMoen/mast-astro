---
/**
 * The closing call to action.
 *  standard:  a centered (or left) heading with actions beneath
 *  offset:    heading and actions on opposite sides, bottom-aligned
 *  editorial: a display-size heading, actions set to the far corner
 */
import Section from "@/components/Section.astro";
import Row from "@/components/Row.astro";
import Col from "@/components/Col.astro";
import Spacer from "@/components/Spacer.astro";
import Intro from "./Intro.astro";
import Actions from "./Actions.astro";
import { getChoices, type Choices } from "@/dials.ts";
import { isCentered, measure, breath } from "./rhythm.ts";

interface Props {
  /** Override the dials for this one section. */
  choices?: Partial<Choices>;
  title: string;
  body?: string;
  primary?: string;
  secondary?: string;
  theme?: "base" | "alt";
}

const layout = { ...getChoices(), ...Astro.props.choices };
const { title, body, primary, secondary, theme = "base" } = Astro.props;
const centered = isCentered(layout, "cta");
---

<Section {theme} data-recipe="cta" data-variant={layout.composition}>
  {
    layout.composition === "standard" && (
      <Row justify={centered ? "center" : "start"}>
        <Col size={measure(layout)}>
          <Intro choices={layout} {title} {body} role="cta">
            <Actions
              {primary}
              {secondary}
              justify={centered ? "center" : "start"}
            />
          </Intro>
        </Col>
      </Row>
    )
  }
  {
    layout.composition === "offset" && (
      <Row justify="between" align="end">
        <Col size={6}>
          <Intro choices={layout} {title} {body} role="body" />
        </Col>
        <Col size="shrink">
          <Actions {primary} {secondary} />
        </Col>
      </Row>
    )
  }
  {
    layout.composition === "editorial" && (
      <>
        <Row justify={centered ? "center" : "start"}>
          <Col size={10}>
            <Intro choices={layout} {title} size="h1" role="cta" />
          </Col>
        </Row>
        <Spacer size={breath(layout) ?? "md"} />
        <Actions {primary} {secondary} justify={centered ? "center" : "end"} />
      </>
    )
  }
</Section>
