---
/**
 * The header of an inner page: a title and a short introduction.
 *  standard:  one column, centered or left
 *  offset:    title and intro side by side, bottom-aligned
 *  editorial: a full-width title with the intro set low and right
 */
import Section from "@/components/Section.astro";
import Row from "@/components/Row.astro";
import Col from "@/components/Col.astro";
import Spacer from "@/components/Spacer.astro";
import Intro from "./Intro.astro";
import { getChoices, type Choices } from "@/dials.ts";
import { isCentered, measure, breath } from "./rhythm.ts";

interface Props {
  /** Override the dials for this one section. */
  choices?: Partial<Choices>;
  eyebrow?: string;
  title: string;
  body: string;
}

const layout = { ...getChoices(), ...Astro.props.choices };
const { eyebrow, title, body } = Astro.props;
const centered = isCentered(layout, "intro");
---

<Section
  tag="header"
  data-recipe="page-header"
  data-variant={layout.composition}
>
  {
    layout.composition === "standard" && (
      <Row justify={centered ? "center" : "start"}>
        <Col size={measure(layout)}>
          <Intro choices={layout} {eyebrow} {title} {body} level={1} />
        </Col>
      </Row>
    )
  }
  {
    layout.composition === "offset" && (
      <Row justify="between" align="end">
        <Col size={6}>
          <Intro choices={layout} {eyebrow} {title} level={1} role="body" />
        </Col>
        <Col size={layout.whitespace === "generous" ? 4 : 5}>
          <div class="rich-text cc-lg">
            <p>{body}</p>
          </div>
        </Col>
      </Row>
    )
  }
  {
    layout.composition === "editorial" && (
      <>
        <Intro choices={layout} {eyebrow} {title} level={1} />
        <Spacer size={breath(layout) ?? "md"} />
        <Row justify={centered ? "center" : "end"}>
          <Col size={centered ? measure(layout) : 5}>
            <div
              class:list={["rich-text", "cc-lg", centered && "u-text-center"]}
            >
              <p>{body}</p>
            </div>
          </Col>
        </Row>
      </>
    )
  }
</Section>
