---
/**
 * The opening section of a page.
 *  standard:  one centered or left column of copy and actions
 *  offset:    copy and a framed image in an uneven split
 *  editorial: an oversized headline, then copy anchored opposite the
 *             actions, then full-width media
 */
import Section from "@/components/Section.astro";
import Row from "@/components/Row.astro";
import Col from "@/components/Col.astro";
import Card from "@/components/Card.astro";
import Img from "@/components/Img.astro";
import Spacer from "@/components/Spacer.astro";
import Intro from "./Intro.astro";
import Actions from "./Actions.astro";
import { getChoices, type Choices } from "@/dials.ts";
import { isCentered, measure, breath } from "./rhythm.ts";

interface Props {
  /** Override the dials for this one section. */
  choices?: Partial<Choices>;
  eyebrow?: string;
  title: string;
  body: string;
  primary?: string;
  secondary?: string;
  image: string;
  imageAlt?: string;
}

const layout = { ...getChoices(), ...Astro.props.choices };
const {
  eyebrow,
  title,
  body,
  primary,
  secondary,
  image,
  imageAlt = "",
} = Astro.props;
const centered = isCentered(layout, "intro");
const space = breath(layout);
---

{
  layout.composition === "standard" && (
    <Section tag="header" data-recipe="hero" data-variant={layout.composition}>
      <Row justify={centered ? "center" : "start"}>
        <Col size={measure(layout)}>
          <Intro choices={layout} {eyebrow} {title} {body} level={1}>
            <Actions
              {primary}
              {secondary}
              justify={centered ? "center" : "start"}
            />
          </Intro>
        </Col>
      </Row>
    </Section>
  )
}
{
  layout.composition === "offset" && (
    <Section tag="header" data-recipe="hero" data-variant={layout.composition}>
      <Row justify="between" align="center">
        <Col size={layout.whitespace === "generous" ? 5 : 6}>
          <Intro choices={layout} {eyebrow} {title} {body} level={1}>
            <Actions
              {primary}
              {secondary}
              justify={centered ? "center" : "start"}
            />
          </Intro>
        </Col>
        <Col size={6}>
          <Card>
            <Img src={image} alt={imageAlt} ratio="1x1" loading="eager" />
          </Card>
        </Col>
      </Row>
    </Section>
  )
}
{
  layout.composition === "editorial" && (
    <Section tag="header" data-recipe="hero" data-variant={layout.composition}>
      <Row justify={centered ? "center" : "start"}>
        <Col size={centered ? 10 : 11}>
          <Intro choices={layout} {eyebrow} {title} level={1} />
        </Col>
      </Row>
      {space && <Spacer size={space} />}
      <Row justify={centered ? "center" : "between"} align="end">
        <Col size={centered ? measure(layout) : 5}>
          <div class:list={["rich-text", "cc-lg", centered && "u-text-center"]}>
            <p>{body}</p>
          </div>
        </Col>
        {!centered && (
          <Col size="shrink">
            <Actions {primary} {secondary} />
          </Col>
        )}
      </Row>
      {centered && (
        <>
          <Spacer size="md" />
          <Actions {primary} {secondary} justify="center" />
        </>
      )}
      <Spacer size={space ?? "main"} />
      <Card>
        <Img src={image} alt={imageAlt} ratio="16x9" loading="eager" />
      </Card>
    </Section>
  )
}
