---
import Icon from "@/components/Icon.astro";
---

<div class="theme-toggle-component">
  <label class="theme-toggle-label">
    <span data-theme-toggle="dark-label" class="theme-toggle-state cc-base">
      <Icon name="moon-stars" class="u-mb-0" />
    </span>
    <span data-theme-toggle="light-label" class="theme-toggle-state cc-invert">
      <Icon name="sun" class="u-mb-0" />
    </span>
    <input
      type="checkbox"
      data-theme-toggle="checkbox"
      class="theme-toggle-checkbox"
      aria-label="Switch between dark and light mode"
    />
  </label>
</div>
