---
import BaseHead from "../components/BaseHead.astro";

interface Props {
  title: string;
  description?: string;
  /** Appended to page titles; see BaseHead. */
  siteName?: string;
  /** The document language. */
  lang?: string;
  /**
   * Utility pages (404, 401) center a single container on the viewport.
   * The page provides its own `<main id="main">` (the layout's would
   * break the centering wrapper).
   */
  utility?: boolean;
}

const {
  title,
  description,
  siteName,
  lang = "en",
  utility = false,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} siteName={siteName} />
    {/* Site-level head content: favicons, font preloads, theme-color. */}
    <slot name="head" />
  </head>
  <body>
    <div class:list={["page-wrapper", utility ? "cc-utility" : "u-minh-100vh"]}>
      <slot name="nav" />
      {
        utility ? (
          <slot />
        ) : (
          <main id="main" class="page-main">
            <slot />
          </main>
        )
      }
      <slot name="footer" />
    </div>
    <script>
      import "../scripts/stagger.ts";
      import "../scripts/a11y.ts";
    </script>
  </body>
</html>
