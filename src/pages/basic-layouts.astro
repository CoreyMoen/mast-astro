---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NavBanner from "@/components/NavBanner.astro";
import Nav from "@/components/Nav.astro";
import NavDropdown from "@/components/NavDropdown.astro";
import Footer from "@/components/Footer.astro";
import Section from "@/components/Section.astro";
import Row from "@/components/Row.astro";
import Col from "@/components/Col.astro";
import ContentWrap from "@/components/ContentWrap.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import Heading from "@/components/Heading.astro";
import RichText from "@/components/RichText.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/Card.astro";
import CardBody from "@/components/CardBody.astro";
import Icon from "@/components/Icon.astro";
import Img from "@/components/Img.astro";
import Spacer from "@/components/Spacer.astro";
import Accordion from "@/components/Accordion.astro";
---

<BaseLayout title="Basic Layouts">
  <Fragment slot="nav">
    <NavBanner href="#">Mast — a CSS framework for Webflow</NavBanner>
    <Nav>
      <a href="#" class="nav-link">Static Link</a>
      <NavDropdown label="Simple Drop">
        <a href="#" class="nav-link cc-dropdown-link">Link 1</a>
        <a href="#" class="nav-link cc-dropdown-link">Link 2</a>
        <a href="#" class="nav-link cc-dropdown-link">Link 3</a>
      </NavDropdown>
      <NavDropdown label="Mega Drop" mega>
        <Row bare>
          <Col bare lg={3} md={6} sm={12}>
            <h2 class="eyebrow">Category</h2>
            <ul role="list" class="u-mb-0 u-list-unstyled">
              <li>
                <a href="#" class="nav-link cc-dropdown-link">Link 1</a>
              </li>
              <li>
                <a href="#" class="nav-link cc-dropdown-link">Link 2</a>
              </li>
              <li class="u-mb-0">
                <a href="#" class="nav-link cc-dropdown-link">Link 3</a>
              </li>
            </ul>
          </Col>
          <Col bare lg={3} md={6} sm={12}>
            <h2 class="eyebrow">Category</h2>
            <ul role="list" class="u-mb-0 u-list-unstyled">
              <li>
                <a href="#" class="nav-link cc-dropdown-link">Link 1</a>
              </li>
              <li>
                <a href="#" class="nav-link cc-dropdown-link">Link 2</a>
              </li>
              <li class="u-mb-0">
                <a href="#" class="nav-link cc-dropdown-link">Link 3</a>
              </li>
            </ul>
          </Col>
          <Col bare lg={3} md={6} sm={12}>
            <h2 class="eyebrow">Category</h2>
            <ul role="list" class="u-mb-0 u-list-unstyled">
              <li>
                <a href="#" class="nav-link cc-dropdown-link">Link 1</a>
              </li>
              <li>
                <a href="#" class="nav-link cc-dropdown-link">Link 2</a>
              </li>
              <li class="u-mb-0">
                <a href="#" class="nav-link cc-dropdown-link">Link 3</a>
              </li>
            </ul>
          </Col>
          <Col bare lg={3} md={6} sm={12}>
            <h2 class="eyebrow">Category</h2>
            <ul role="list" class="u-mb-0 u-list-unstyled">
              <li>
                <a href="#" class="nav-link cc-dropdown-link">Link 1</a>
              </li>
              <li>
                <a href="#" class="nav-link cc-dropdown-link">Link 2</a>
              </li>
              <li class="u-mb-0">
                <a href="#" class="nav-link cc-dropdown-link">Link 3</a>
              </li>
            </ul>
          </Col>
        </Row>
      </NavDropdown>
      <Button slot="cta" href="#">Primary CTA</Button>
    </Nav>
  </Fragment>

  {/* Hero header */}
  <Section tag="header">
    <Row justify="center">
      <Col size={9}>
        <ContentWrap align="center">
          <Eyebrow>Lorem ipsum</Eyebrow>
          <Heading tag="h1">A simple header</Heading>
          <RichText>
            <p>
              Lorem ipsum dolor sit amet consectetur adipiscing elit enim
              porttitor, ornare luctus dignissim posuere platea aliquam turpis
              taciti fusce, diam arcu mollis phasellus mattis ad suspendisse
              integer.
            </p>
          </RichText>
          <Row justify="center" align="center" gap="button">
            <Col size="shrink">
              <Button href="#">Button</Button>
            </Col>
            <Col size="shrink">
              <Button href="#" variant="secondary">Button</Button>
            </Col>
          </Row>
        </ContentWrap>
      </Col>
    </Row>
  </Section>

  {/* Split header: copy + square image card */}
  <Section theme="alt">
    <Row justify="between" align="center">
      <Col size={5}>
        <Eyebrow>Lorem ipsum</Eyebrow>
        <Heading tag="h2" size="h1">Another header</Heading>
        <RichText>
          <p>
            Lorem ipsum dolor sit amet consectetur adipiscing elit enim
            porttitor, ornare luctus dignissim posuere platea aliquam turpis
            taciti fusce, diam arcu mollis phasellus mattis ad suspendisse
            integer.
          </p>
        </RichText>
        <Row gap="button">
          <Col size="shrink">
            <Button href="#">Button</Button>
          </Col>
          <Col size="shrink">
            <Button href="#" variant="secondary">Button</Button>
          </Col>
        </Row>
      </Col>
      <Col size={6}>
        <Card>
          <Img
            src="/images/post4.webp"
            alt=""
            ratio="1x1"
            sizes="(max-width: 800px) 100vw, 800px"
            srcset="/images/post4-p-500.webp 500w, /images/post4-p-800.webp 800w, /images/post4-p-1080.webp 1080w, /images/post4-p-1600.webp 1600w, /images/post4.webp 2000w"
          />
        </Card>
      </Col>
    </Row>
  </Section>

  {/* Centered intro + four icon features */}
  <Section>
    <Row justify="center">
      <Col size={9}>
        <ContentWrap align="center">
          <Eyebrow>Lorem ipsum</Eyebrow>
          <Heading tag="h2">This is a section title</Heading>
          <RichText>
            <p>
              Lorem ipsum dolor sit amet consectetur adipiscing elit enim
              porttitor, ornare luctus dignissim posuere platea aliquam turpis
              taciti fusce, diam arcu mollis phasellus mattis ad suspendisse
              integer.
            </p>
          </RichText>
        </ContentWrap>
      </Col>
    </Row>
    <Spacer />
    <Row>
      <Col size={3}>
        <ContentWrap align="center">
          <Icon name="check-circle" size="lg" color="accent" class="u-mb-sm" />
          <RichText>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
          </RichText>
        </ContentWrap>
      </Col>
      <Col size={3}>
        <ContentWrap align="center">
          <Icon name="target" size="lg" color="accent" class="u-mb-sm" />
          <RichText>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
          </RichText>
        </ContentWrap>
      </Col>
      <Col size={3}>
        <ContentWrap align="center">
          <Icon name="star" size="lg" color="accent" class="u-mb-sm" />
          <RichText>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
          </RichText>
        </ContentWrap>
      </Col>
      <Col size={3}>
        <ContentWrap align="center">
          <Icon name="trophy" size="lg" color="accent" class="u-mb-sm" />
          <RichText>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
          </RichText>
        </ContentWrap>
      </Col>
    </Row>
  </Section>

  {/* Title + 2x2 icon feature grid */}
  <Section theme="alt">
    <Row justify="between">
      <Col size={5}>
        <Heading tag="h2">This is a section title</Heading>
        <RichText>
          <p>
            Lorem ipsum dolor sit amet consectetur adipiscing elit enim
            porttitor, ornare luctus dignissim posuere platea aliquam turpis
            taciti fusce, diam arcu mollis phasellus mattis ad suspendisse
