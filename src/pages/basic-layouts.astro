                </Col>
                <Col>
                  <RichText>
                    <p>
                      Lorem ipsum dolor sit amet consectetur adipiscing elit
                      enim porttitor, ornare luctus dignissim posuere platea
                      aliquam turpis taciti fusce.
                    </p>
                  </RichText>
                </Col>
              </Row>
              <Row gap="md" role="listitem">
                <Col size="shrink">
                  <Icon
                    name="target"
                    size="lg"
                    color="accent"
                    class="u-mb-sm"
                  />
                </Col>
                <Col>
                  <RichText>
                    <p>
                      Lorem ipsum dolor sit amet consectetur adipiscing elit
                      enim porttitor, ornare luctus dignissim posuere platea
                      aliquam turpis taciti fusce.
                    </p>
                  </RichText>
                </Col>
              </Row>
            </ContentWrap>
          </Col>
          <Col size={6} md={12}>
            <div class="img-component cc-1x1 u-h-100" style="max-width: 60rem;">
              <img
                class="u-img-cover"
                src="/images/post3.webp"
                alt=""
                loading="lazy"
                sizes="(max-width: 800px) 100vw, 800px"
                srcset="/images/post3-p-500.webp 500w, /images/post3-p-800.webp 800w, /images/post3-p-1080.webp 1080w, /images/post3-p-1600.webp 1600w, /images/post3.webp 2000w"
              />
            </div>
          </Col>
        </Row>
      </div>
    </div>
  </Section>

  {/* Offset title/copy + two feature cards */}
  <Section>
    <Row justify="between" align="end" gap="md">
      <Col size={4}>
        <Heading tag="h2" class="u-mb-0">This is a section title</Heading>
      </Col>
      <Col size={6}>
        <RichText>
          <p>
            Lorem ipsum dolor sit amet consectetur adipiscing elit, posuere
            bibendum per congue conubia justo laoreet, habitasse auctor vel
            pellentesque sapien aptent.
          </p>
