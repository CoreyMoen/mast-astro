              </p>
            </RichText>
          </CardBody>
        </Card>
      </Col>
    </Row>
  </Section>

  {/* FAQ accordions */}
  <Section theme="alt">
    <Row justify="between">
      <Col size={4}>
        <Heading tag="h2" class="u-mb-0">Have a question?</Heading>
      </Col>
      <Col size={7}>
        <ContentWrap>
          <Accordion title="Lorem ipsum?" class="u-mb-sm" role="listitem">
            <RichText>
              <p>
                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
