              <div class="styles__selector-callout">u-bg-primary</div>
            </div>
          </div>
        </div>
      </div>
      <h4 class="u-mt-md">Secondary</h4>
      <div class="row">
        <div class="col col-lg-4 col-md-6 col-xs-12">
          <div class="styles__card">
            <div class="u-bg-yellow">
              <div class="styles__card-preview"></div>
            </div>
            <div class="card-body">
              <h4 class="u-mb-0">Yellow</h4>
              <div class="u-mb-sm">#f8d47a</div>
              <div class="styles__selector-callout">u-bg-yellow</div>
            </div>
          </div>
        </div>
        <div class="col col-lg-4 col-md-6 col-xs-12">
          <div class="styles__card">
            <div class="u-bg-blue">
              <div class="styles__card-preview"></div>
            </div>
            <div class="card-body">
              <h4 class="u-mb-0">Blue</h4>
              <div class="u-mb-sm">#0073e6</div>
              <div class="styles__selector-callout">u-bg-blue</div>
            </div>
          </div>
        </div>
      </div>
      <h4 class="u-mt-md">Neutral</h4>
      <div class="row">
        <div class="col col-lg-4 col-md-6 col-xs-12">
          <div class="styles__card">
            <div class="u-bg-black">
              <div class="styles__card-preview"></div>
            </div>
            <div class="card-body">
              <h4 class="u-mb-0">Black</h4>
              <div class="u-mb-sm">#1d1c1a</div>
              <div class="styles__selector-callout">u-bg-black</div>
            </div>
          </div>
        </div>
        <div class="col col-lg-4 col-md-6 col-xs-12">
          <div class="styles__card">
            <div class="u-bg-darkgray">
              <div class="styles__card-preview"></div>
            </div>
            <div class="card-body">
              <h4 class="u-mb-0">Dark Gray</h4>
              <div class="u-mb-sm">#292825</div>
