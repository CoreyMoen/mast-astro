---
import "@/styles/styleguide.css";
import BaseLayout from "@/layouts/BaseLayout.astro";
import StyleGuideNav from "@/components/styleguide/StyleGuideNav.astro";
import Button from "@/components/Button.astro";
import Divider from "@/components/Divider.astro";
---

<BaseLayout
  title="Styles"
  description="Typography, color, utilities, and the layout system of the Mast framework."
>
  <StyleGuideNav
    slot="nav"
    links={[
      { label: "Home", href: "/", divider: true },
      { label: "Type", href: "#typography" },
      { label: "Color", href: "#color" },
      { label: "Utilities", href: "#utilities" },
      { label: "Layout", href: "#layout" },
      { label: "Docs", href: "https://nocodesupply.co/mast/docs", cta: true },
    ]}
  />
  <section id="typography" class="section">
    <div class="container">
      <h1 class="u-mb-md">Styles</h1>
      <h2>Typography</h2>
      <h3 class="styles__section-label">Fonts</h3>
      <div class="row">
        <div class="col col-lg-6 col-sm-12">
          <div class="styles__card">
            <div class="page-wrapper">
              <div class="styles__card-preview">
                <div class="card-body">
                  <p class="h2 u-mt-sm u-mb-sm">General Sans</p>
                </div>
              </div>
            </div>
            <div class="card-body">
              <h4 class="h3">Headings + Body</h4>
              <div><strong>Type:</strong> Sans Serif</div>
              <div><strong>Weights:</strong> Normal (400), Medium (500)</div>
            </div>
          </div>
        </div>
      </div>
      <h3 class="styles__section-label">Headings</h3>
      <div class="row">
        <div class="col col-lg-6 col-sm-12">
          <div class="u-mb-lg">
            <div class="u-mb-sm">
              <div class="styles__selector-callout cc-element">H1 Headings</div>
            </div>
            {/* Specimens are presentational so the page keeps one h1. */}
            <h1 role="presentation">Element<br /></h1>
          </div>
          <div class="u-mb-lg">
            <div class="u-mb-sm">
              <div class="styles__selector-callout cc-element">H2 Headings</div>
            </div>
            <h2>Element</h2>
          </div>
          <div class="u-mb-lg">
            <div class="u-mb-sm">
              <div class="styles__selector-callout cc-element">H3 Headings</div>
            </div>
            <h3>Element</h3>
          </div>
          <div class="u-mb-lg">
            <div class="u-mb-sm">
              <div class="styles__selector-callout cc-element">H4 Headings</div>
            </div>
            <h4>Element</h4>
          </div>
          <div class="u-mb-lg">
            <div class="u-mb-sm">
              <div class="styles__selector-callout cc-element">H5 Headings</div>
            </div>
            <h5>Element</h5>
          </div>
          <div>
            <div class="u-mb-sm">
              <div class="styles__selector-callout cc-element">H6 Headings</div>
            </div>
            <h6>Element</h6>
          </div>
        </div>
        <div class="col col-lg-6 col-sm-12">
          <div class="u-mb-lg">
            <div class="u-mb-sm">
              <div class="styles__selector-callout">h1</div>
            </div>
            <div class="h1">Class</div>
          </div>
          <div class="u-mb-lg">
            <div class="u-mb-sm">
              <div class="styles__selector-callout">h2</div>
            </div>
            <div class="h2">Class</div>
          </div>
          <div class="u-mb-lg">
            <div class="u-mb-sm">
              <div class="styles__selector-callout">h3</div>
            </div>
            <div class="h3">Class</div>
          </div>
          <div class="u-mb-lg">
            <div class="u-mb-sm">
              <div class="styles__selector-callout">h4</div>
            </div>
            <div class="h4">Class</div>
          </div>
          <div class="u-mb-lg">
            <div class="u-mb-sm">
              <div class="styles__selector-callout">h5</div>
            </div>
            <div class="h5">Class</div>
          </div>
          <div>
            <div class="u-mb-sm">
              <div class="styles__selector-callout">h6</div>
            </div>
            <div class="h6">Class</div>
          </div>
        </div>
      </div>
      <h3 class="styles__section-label">Body</h3>
      <div>
        <div class="u-mb-lg">
          <div class="u-mb-sm">
            <div class="styles__selector-callout">paragraph-xl</div>
          </div>
          <p class="paragraph-xl">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse
            varius enim in eros elementum tristique.
          </p>
        </div>
        <div class="u-mb-lg">
          <div class="u-mb-sm">
            <div class="styles__selector-callout">paragraph-lg</div>
          </div>
          <p class="paragraph-lg">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse
            varius enim in eros elementum tristique.
          </p>
        </div>
        <div class="u-mb-lg">
          <div class="u-mb-sm">
            <div class="styles__selector-callout cc-element">Body</div>
            <div class="styles__selector-callout cc-element">Paragraphs</div>
          </div>
          <p>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse
            varius enim in eros elementum tristique.
          </p>
        </div>
        <div class="u-mb-lg">
          <div class="u-mb-sm">
            <div class="styles__selector-callout">paragraph-sm</div>
          </div>
          <p class="paragraph-sm">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse
            varius enim in eros elementum tristique.
          </p>
        </div>
        <div class="u-mb-lg">
          <div class="u-mb-sm">
            <div class="styles__selector-callout">eyebrow</div>
          </div>
          <div class="eyebrow">Lorem Ipsum</div>
        </div>
        <div class="u-mb-lg">
          <div class="u-mb-sm">
            <div class="styles__selector-callout cc-element">
              All Ordered Lists
            </div>
          </div>
          <ol role="list">
            <li>Example Ordered List</li>
            <li>Example Ordered List</li>
          </ol>
        </div>
        <div class="u-mb-lg">
          <div class="u-mb-sm">
            <div class="styles__selector-callout cc-element">
              All Unordered Lists
            </div>
          </div>
          <ul role="list">
            <li>Example Unordered List</li>
            <li>Example Unordered List</li>
          </ul>
        </div>
        <div>
          <div class="u-mb-sm">
            <div class="styles__selector-callout">rich-text</div>
          </div>
          <div class="rich-text">
            <h1 role="presentation">Heading 1</h1>
            <h2>Heading 2</h2>
            <h3>Heading 3</h3>
            <h4>Heading 4</h4>
            <h5>Heading 5</h5>
            <h6>Heading 6</h6>
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
              eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut
              enim ad minim veniam, quis nostrud exercitation <code
                >ullamco laboris nisi ut aliquip</code
              > ex ea commodo consequat. Duis aute irure dolor in reprehenderit in
              voluptate velit esse cillum dolore eu fugiat nulla pariatur.
            </p>
            <blockquote>Block quote</blockquote>
            <pre
              style="display:block;overflow-x:auto;background:#2b2b2b;color:#f8f8f2;padding:0.5em"><code class="language-htmlbars" style="white-space:pre-wrap"><span><span class="xml" style="color:#ffa07a">&lt;</span><span class="xml" style="color:#ffa07a">div</span><span class="xml" style="color:#ffa07a">&gt;</span><span class="xml">example code block here</span><span class="xml" style="color:#ffa07a">&lt;/</span><span class="xml" style="color:#ffa07a">div</span><span class="xml" style="color:#ffa07a">&gt;</span></span></code></pre>
            <p>Ordered list</p>
            <ol role="list">
              <li>Item 1</li>
              <li>Item 2</li>
              <li>Item 3</li>
            </ol>
            <p>Unordered list</p>
            <ul role="list">
              <li>Item A</li>
              <li>Item B</li>
              <li>Item C</li>
            </ul>
            <p>
              <a href="https://nocodesupply.co/mast">Text link</a>
            </p>
            <p><strong>Bold text</strong></p>
            <p><em>Emphasis</em></p>
            <p><sup>Superscript</sup></p>
            <p><sub>Subscript</sub></p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <Divider size="0" />
  <section id="color" class="section">
    <div class="container">
      <h2>Color</h2>
      <h3 class="styles__section-label">Background</h3>
      <h4>Primary</h4>
      <div class="row">
        <div class="col col-lg-4 col-md-6 col-xs-12">
