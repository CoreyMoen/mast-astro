              <div class="styles__card-preview"></div>
            </div>
            <div class="card-body">
              <h4 class="u-mb-0">Mid Gray 2</h4>
              <div class="u-mb-sm">#474641</div>
              <div class="styles__selector-callout">u-bg-midgray-2</div>
            </div>
          </div>
        </div>
        <div class="col col-lg-4 col-md-6 col-xs-12">
          <div class="styles__card">
            <div class="u-bg-midgray-1">
              <div class="styles__card-preview"></div>
            </div>
            <div class="card-body">
              <h4 class="u-mb-0">Mid Gray 1</h4>
              <div class="u-mb-sm">#cccabf</div>
              <div class="styles__selector-callout">u-bg-midgray-1</div>
            </div>
          </div>
        </div>
        <div class="col col-lg-4 col-md-6 col-xs-12">
          <div class="styles__card">
            <div class="u-bg-lightgray">
              <div class="styles__card-preview"></div>
            </div>
            <div class="card-body">
              <h4 class="u-mb-0">Light Gray</h4>
              <div class="u-mb-sm">#f0eee6</div>
              <div class="styles__selector-callout">u-bg-lightgray</div>
            </div>
          </div>
        </div>
        <div class="col col-lg-4 col-md-6 col-xs-12">
          <div class="styles__card">
            <div class="u-bg-white">
              <div class="styles__card-preview"></div>
            </div>
            <div class="card-body">
              <h4 class="u-mb-0">White</h4>
              <div class="u-mb-sm">#ffffff</div>
              <div class="styles__selector-callout">u-bg-white</div>
            </div>
          </div>
        </div>
      </div>
      <h3 class="styles__section-label">Text</h3>
      <div class="row">
        <div class="col col-lg-4 col-md-6 col-xs-12">
          <div class="styles__card">
            <div class="u-bg-white">
              <div class="styles__card-preview">
                <div class="h2 u-mb-0">
                  <div class="u-text-primary">Aa</div>
                </div>
              </div>
            </div>
            <div class="card-body">
              <h4 class="u-mb-0">Primary</h4>
              <div class="u-mb-sm">#d14424</div>
              <div class="styles__selector-callout">u-text-primary</div>
            </div>
          </div>
        </div>
        <div class="col col-lg-4 col-md-6 col-xs-12">
          <div class="styles__card">
            <div class="u-bg-white">
              <div class="styles__card-preview">
                <div class="h2 u-mb-0">
                  <div class="u-text-black">Aa</div>
                </div>
              </div>
            </div>
            <div class="card-body">
              <h4 class="u-mb-0">Black</h4>
              <div class="u-mb-sm">#1d1c1a</div>
              <div class="styles__selector-callout">u-text-black</div>
