---
import { getCollection, render } from "astro:content";
import SiteLayout from "@/layouts/SiteLayout.astro";
import DemoNav from "@/components/DemoNav.astro";
import DemoFooter from "@/components/DemoFooter.astro";
import {
  Card,
  CardBody,
  Col,
  ContentWrap,
  Img,
  Row,
  Section,
  Slide,
  Slider,
} from "mast-astro";
import {
  postSrc,
  postSrcset,
  postSizes,
  postHeroSizes,
  formatDate,
} from "@/lib/blog.ts";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const morePosts = (await getCollection("blog"))
  .filter((entry) => entry.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<SiteLayout title={post.data.title} description={post.data.description}>
  <Fragment slot="nav">
    <DemoNav />
  </Fragment>

  <article>
    <Section tag="header" class="u-pb-0">
      <Row justify="center">
        <Col size={8}>
          <ContentWrap align="center">
            <h1>{post.data.title}</h1>
            <p class="paragraph-lg">{post.data.description}</p>
            <time
              class="paragraph-sm"
              datetime={post.data.date.toISOString().slice(0, 10)}
            >
              {formatDate(post.data.date)}
            </time>
          </ContentWrap>
        </Col>
      </Row>
    </Section>

    <Section class="u-pb-0">
      <Row justify="center">
        <Col size={10}>
          <Card>
            <Img
              ratio="16x9"
              src={postSrc(post.data.image)}
              srcset={postSrcset(post.data.image)}
              sizes={postHeroSizes}
              alt={post.data.imageAlt}
              loading="eager"
              fetchpriority="high"
            />
          </Card>
        </Col>
      </Row>
    </Section>

    <Section>
      <Row justify="center">
        <Col size={8}>
          <div class="rich-text">
            <Content />
          </div>
        </Col>
      </Row>
    </Section>
  </article>

  <Section theme="alt">
    <Slider lg={3} md={2} sm={1} xs={1} gap="md" overflow navPosition="header">
      <h2 class="u-mb-0" slot="header">More from the blog</h2>
      {
        morePosts.map((entry) => (
          <Slide>
            <Card
              hover
              href={`/blog/${entry.id}`}
              linkLabel={entry.data.title}
              class="u-h-100"
            >
              <Img
                src={postSrc(entry.data.image)}
                srcset={postSrcset(entry.data.image)}
                sizes={postSizes}
                alt={entry.data.imageAlt}
              />
              <CardBody>
                <h3 class="h4">{entry.data.title}</h3>
                <p class="u-mb-0">{entry.data.description}</p>
              </CardBody>
            </Card>
          </Slide>
        ))
      }
    </Slider>
  </Section>

  <DemoFooter slot="footer" />
</SiteLayout>
